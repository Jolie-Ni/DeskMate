<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime blocks Apple events outright unless this is
	     present, which would silently kill browser URL capture in any
	     notarized build. Not needed for ad-hoc builds, but harmless there. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
